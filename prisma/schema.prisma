generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SprintStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  P0
  P1
  P2
  P3
}

enum TaskType {
  FEATURE
  BUG
  CHORE
  SPIKE
}

enum ActivityKind {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  SPRINT_CHANGED
  UPDATED
}

model Project {
  id             String   @id @default(uuid())
  name           String
  key            String   @unique
  description    String?
  color          String   @default("#6366f1")
  /// Per-project counter used to mint task numbers (CORE-1, CORE-2, ...).
  nextTaskNumber Int      @default(1)
  /// Archived projects are hidden everywhere except /projects and their own (read-only-ish) pages.
  archivedAt     DateTime?
  /// Starred projects are pinned in the sidebar; ordered by when they were starred.
  starredAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sprints Sprint[]
  tasks   Task[]
}

model Sprint {
  id          String       @id @default(uuid())
  projectId   String
  name        String
  goal        String?
  status      SprintStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, status])
}

model Task {
  id          String     @id @default(uuid())
  projectId   String
  sprintId    String?
  taskNumber  Int
  title       String
  description String     @default("")
  status      TaskStatus @default(BACKLOG)
  priority    Priority   @default(P2)
  type        TaskType   @default(FEATURE)
  orderIndex  Float      @default(1000.0)
  branchName  String?
  prUrl       String?
  labels      String[]   @default([])
  estimate    Int?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint     Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  subtasks   Subtask[]
  comments   Comment[]
  activities Activity[]

  @@unique([projectId, taskNumber])
  @@index([projectId, status, orderIndex])
  @@index([sprintId, status, orderIndex])
  @@index([projectId, sprintId])
  @@index([dueDate])
}

model Subtask {
  id         String   @id @default(uuid())
  taskId     String
  title      String
  done       Boolean  @default(false)
  orderIndex Float    @default(1000.0)
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, orderIndex])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Activity {
  id        String       @id @default(uuid())
  taskId    String
  kind      ActivityKind
  detail    String
  createdAt DateTime     @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

/// Recently opened / worked-on items, shared by every device (the app has no accounts).
/// The reserved row id "__cleared" remembers when the list was last cleared so stale devices can't resurrect old items.
model RecentItem {
  id         String    @id // "board:CORE" | "backlog:CORE" | "task:CORE-12" | "central" | "__cleared"
  kind       String
  projectKey String?
  taskKey    String?
  title      String?
  taskType   TaskType?
  visitedAt  DateTime

  @@index([visitedAt])
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
}

/// Personal to-do list: quick checklist items that live outside projects and sprints.
model Todo {
  id        String    @id @default(uuid())
  title     String
  done      Boolean   @default(false)
  doneAt    DateTime?
  dueDate   DateTime?
  priority  TodoPriority @default(LOW)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([done, createdAt])
}

/// A browser/device that agreed to receive push notifications.
model PushSubscription {
  id         String   @id @default(uuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  timezone   String   @default("UTC") // IANA name from the device, so "today" means the user's today
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
}

/// What has already been sent, so cron runs (any frequency) never repeat a notification.
model NotificationLog {
  key    String   @id // e.g. "digest:2026-10-19", "stale:CORE"
  sentAt DateTime @default(now())

  @@index([sentAt])
}
